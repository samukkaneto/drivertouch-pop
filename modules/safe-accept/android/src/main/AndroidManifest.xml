<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <package android:name="br.com.popmove.driver" />
  </queries>
  <application>
    <service
      android:name=".PopMoveAccessibilityService"
      android:description="@string/popmove_safe_accept_service_description"
      android:exported="true"
      android:label="Toalha Vermelha"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/popmove_safe_accept_service" />
    </service>
    <service
      android:name=".PopMoveNotificationListenerService"
      android:exported="true"
      android:label="Toalha Vermelha - Notificações"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
